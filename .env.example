# Required (unless CONFIG_FILE is set): GitHub repository in owner/repo format
GITHUB_REPO=jxlarrea/kiosk-satellite

# Optional: GitHub Personal Access Token for private repos or higher API rate limits
# GITHUB_TOKEN=

# Optional: How often to check GitHub for updates (Go duration: e.g. 15m, 1h, 24h)
CHECK_INTERVAL=1h

# Optional: 24-hour time of day (HH:MM:SS or HH:MM) to anchor the check schedule (default: 12:00:00)
CHECK_TIME=12:00:00

# Optional: Comma-separated list of file templates/globs to download from the latest release.
# Template variables: {{.Tag}}, {{.Version}} (tag without leading 'v'), {{.Owner}}, {{.Repo}}
# Leave empty to download all assets attached to the release.
FILES=kiosk-satellite-{{.Tag}}.apk,kiosk-satellite-{{.Tag}}.arm64-v8a.apk,kiosk-satellite-{{.Tag}}.armeabi-v7a.apk,kiosk-satellite-{{.Tag}}.x86_64.apk

# Optional: Comma-separated list of substrings to filter downloaded assets (e.g. arm64-v8a,.dmg).
# Only assets whose filename contains at least one of these strings will be downloaded.
# FILE_CONTAINS=

# Optional: Number of releases whose files are kept on disk (<= 0 disables pruning)
KEEP_RELEASES=3

# Optional: Include prereleases when selecting the latest release (true/false)
INCLUDE_PRERELEASES=false

# Optional: Include draft releases (true/false; requires GITHUB_TOKEN)
INCLUDE_DRAFTS=false

# Optional: Rewrite browser_download_url in releases.json to point to this server (true/false)
REWRITE_URLS=false

# Optional: Base URL used when REWRITE_URLS=true (e.g. http://192.168.1.10:8080).
# If empty and REWRITE_URLS=true, root-relative paths (/filename) are used.
# BASE_URL=

# Optional: Number of releases to fetch into releases.json (1-100)
PER_PAGE=30

# Optional: HTTP server listen address
LISTEN_ADDR=:8080

# Optional: Directory where releases.json and downloaded assets are stored
DATA_DIR=/data

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Path to a JSON config file for multi-repo setups (overrides env-based repo config)
# CONFIG_FILE=/config/config.json

# Optional: Override GitHub API base URL (e.g. for GitHub Enterprise Server)
# GITHUB_API_URL=https://api.github.com
